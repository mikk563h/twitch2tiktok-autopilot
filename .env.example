# ======================= Twitch2TikTok Autopilot =======================
# Kopiér til .env og udfyld. Kør ./scripts/gen-secrets.sh for at generere hemmeligheder.

# --- Server ---
DOMAIN=t2t.example.dk                 # domæne der peger på VPS'ens IP (A-record)
ACME_EMAIL=dig@example.dk             # til Let's Encrypt-certifikat
APP_URL=https://t2t.example.dk        # skal matche DOMAIN (bruges i OAuth redirect-URLs)

# --- Hemmeligheder (generér med ./scripts/gen-secrets.sh) ---
POSTGRES_USER=t2t
POSTGRES_DB=t2t
POSTGRES_PASSWORD=
APP_ENCRYPTION_KEY=                   # 64 hex-tegn; krypterer OAuth-tokens i databasen
SESSION_SECRET=                       # lang tilfældig streng
ADMIN_PASSWORD_HASH=                  # scrypt-hash af dashboard-adgangskoden (gen-secrets.sh laver den)
# ADMIN_PASSWORD=                     # alternativ: klartekst (frarådes)

# --- Twitch (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=sondergaardlol

# --- TikTok (https://developers.tiktok.com/apps) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# --- AI (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
WHISPER_MODEL=small                   # base | small | medium (medium = bedre dansk, ~3x langsommere)

# --- Notifikationer ---
SMTP_URL=                             # fx smtps://bruger:kode@smtp.example.dk:465
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=t2t@example.dk
HEARTBEAT_URL=                        # fx https://hc-ping.com/<uuid> (healthchecks.io, gratis)

# --- Ressourcer ---
RENDER_CPUS=3
RENDER_MEM=5g
RENDER_CONCURRENCY=1
BACKUP_KEEP_DAYS=14
LOG_LEVEL=info
